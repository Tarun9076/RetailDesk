# Copy to .env (read by both Next.js and the Prisma CLI). Never commit real values.

# Supabase Postgres: pooled connection (port 6543) for the running app
DATABASE_URL=
# Supabase Postgres: direct connection (port 5432) for migrations
DIRECT_URL=

# Signs session cookies (32+ random chars)
SESSION_SECRET=

# Password for the seeded desk user (desk@retaildesk.demo); used only by `npm run db:seed`
SEED_DESK_PASSWORD=

# Optional: company name in Tally that the export file should import into
TALLY_COMPANY=

# Gemini
GEMINI_API_KEY=
# "-latest" aliases follow Google's current models. The fallback is tried if the first is busy.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# SMS OTP: console | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comma-separated seeded demo numbers that accept OTP_TEST_CODE (demo only, leave empty in real use)
OTP_TEST_NUMBERS=
OTP_TEST_CODE=
