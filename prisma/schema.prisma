// All money is stored as integer paise. Prices are per PIECE; orders are in whole CASES.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RETAILER
  DESK
  SALESMAN
}

enum SchemeType {
  FREE_GOODS    // buy `buyQty` cases, get `freeQty` free
  SLAB_PERCENT  // `percentBp` basis points off when qty >= `minQty` cases
}

enum OrderStatus {
  PLACED     // retailer placed, within credit, awaiting desk check
  ON_HOLD    // blocked by credit limit, desk must release
  CONFIRMED  // desk checked
  EXPORTED   // included in a Tally export
  CANCELLED
}

enum OrderSource {
  CATALOGUE
  AI_TEXT
}

enum CaptureStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

model Retailer {
  id               String   @id @default(cuid())
  name             String
  shopName         String
  phone            String   @unique // E.164, e.g. +919000000001
  city             String
  creditLimitPaise Int
  outstandingPaise Int      @default(0)
  tallyLedgerName  String?
  salesmanId       String? // the salesman who visits this shop; null = not assigned yet
  active           Boolean  @default(true) // false = switched off: cannot sign in or order, hidden from salesmen
  createdAt        DateTime @default(now())

  events   ShopEvent[]
  salesman User?  @relation("SalesmanShops", fields: [salesmanId], references: [id], onDelete: SetNull)
  users    User[] @relation("RetailerLogins")
  prices   RetailerPrice[]
  orders   Order[]
  aliases  Alias[]
  captures AiCapture[]
}

model User {
  id           String    @id @default(cuid())
  role         Role
  name         String
  email        String?   @unique // desk login
  passwordHash String?
  phone        String?   @unique // salesman login (E.164); retailers log in with Retailer.phone
  active       Boolean   @default(true) // false = left the company: cannot sign in, existing sessions stop working
  mustChangePassword Boolean @default(false) // desk staff: set when an admin gives a temporary password
  sessionsValidFrom  DateTime? // logins issued before this moment are rejected (password changed or reset)
  retailerId   String?
  retailer     Retailer? @relation("RetailerLogins", fields: [retailerId], references: [id])
  createdAt    DateTime  @default(now())

  shops        Retailer[] @relation("SalesmanShops") // salesman: the shops assigned to them
  placedOrders Order[]    @relation("PlacedBy") // orders this person entered for a shop
}

model Sku {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  nameHi        String?
  brand         String
  piecesPerCase Int
  pricePaise    Int // dealer price per piece, GST-exclusive
  gstRateBp     Int // 1200 = 12%
  stockCases    Int
  imageUrl      String?
  active        Boolean @default(true)

  schemes       Scheme[]
  retailerPrice RetailerPrice[]
  orderLines    OrderLine[]
  aliases       Alias[]
  events        CatalogueEvent[]
}

// Who changed a product, its price, its stock or its schemes, and what they changed. Never edited.
model CatalogueEvent {
  id        String   @id @default(cuid())
  skuId     String
  kind      String // PRODUCT_CREATED | PRODUCT_UPDATED | STOCK_ADJUSTED | SCHEME_ADDED | SCHEME_CHANGED | SCHEME_REMOVED | SHOP_PRICE_SET | SHOP_PRICE_REMOVED
  summary   String // plain words, e.g. "Dealer price Rs 8.10 -> Rs 8.25"
  byName    String
  createdAt DateTime @default(now())
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, createdAt])
}

// Per-retailer override of the dealer price (per piece, GST-exclusive).
model RetailerPrice {
  retailerId String
  skuId      String
  pricePaise Int
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([retailerId, skuId])
}

model Scheme {
  id         String     @id @default(cuid())
  skuId      String
  type       SchemeType
  buyQty     Int? // FREE_GOODS
  freeQty    Int? // FREE_GOODS
  minQty     Int? // SLAB_PERCENT
  percentBp  Int? // SLAB_PERCENT, 300 = 3%
  label      String
  active     Boolean    @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  sku        Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique // human readable, e.g. RD-000123
  idempotencyKey String?    @unique // client-generated; a double tap cannot create two orders
  retailerId    String
  status        OrderStatus
  source        OrderSource @default(CATALOGUE)
  subtotalPaise Int
  discountPaise Int
  gstPaise      Int
  totalPaise    Int
  holdReason    String?
  note          String?
  rawMessage    String? // original message when captured by AI
  placedById    String? // set when a salesman entered the order on the shop's behalf
  capturedAt    DateTime? // when it was taken, if the phone was offline and sent it later
  createdAt     DateTime    @default(now())
  confirmedAt   DateTime?
  exportedAt    DateTime?

  placedBy User?        @relation("PlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  retailer Retailer     @relation(fields: [retailerId], references: [id])
  lines    OrderLine[]
  events   OrderEvent[]

  @@index([status, createdAt])
  @@index([retailerId, createdAt])
  @@index([placedById, createdAt])
}

// Who did what to an order, and when. Never edited after it is written.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  action    String // CONFIRM | RELEASE | CANCEL | EXPORT
  byName    String
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderLine {
  id               String  @id @default(cuid())
  orderId          String
  skuId            String
  qtyCases         Int
  freeCases        Int     @default(0)
  unitPricePaise   Int // per piece at the time of order
  grossPaise       Int
  discountPaise    Int
  gstPaise         Int
  schemeLabel      String? // snapshot of the applied scheme
  originalText     String? // AI: what the retailer actually wrote
  confidence       Float?
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku              Sku     @relation(fields: [skuId], references: [id])
}

// Learned per-retailer shorthand ("chhota biscuit" -> SKU-BS-075).
model Alias {
  id         String   @id @default(cuid())
  retailerId String
  phrase     String // normalised lower-case
  skuId      String
  createdAt  DateTime @default(now())
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([retailerId, phrase])
}

model AiCapture {
  id         String        @id @default(cuid())
  retailerId String
  rawText    String
  result     Json
  status     CaptureStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  retailer   Retailer      @relation(fields: [retailerId], references: [id], onDelete: Cascade)
}

// Who changed a shop's details, credit limit, balance or status, and what they changed. Never edited.
model ShopEvent {
  id         String   @id @default(cuid())
  retailerId String
  kind       String // SHOP_CREATED | SHOP_UPDATED | SHOP_SWITCHED_OFF | SHOP_SWITCHED_ON | BALANCE_IMPORTED
  summary    String
  byName     String
  createdAt  DateTime @default(now())
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([retailerId, createdAt])
}

// Who added, reset, switched off or switched on desk staff. Never edited.
model StaffEvent {
  id        String   @id @default(cuid())
  userId    String // the staff member the change was about
  kind      String // STAFF_ADDED | PASSWORD_RESET | PASSWORD_CHANGED | SWITCHED_OFF | SWITCHED_ON
  summary   String
  byName    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// One run of "update the amounts shops owe from Tally": previewed first, then applied.
model BalanceImport {
  id        String    @id @default(cuid())
  source    String // UPLOAD | API
  fileName  String?
  byName    String
  status    String // PREVIEW | APPLIED | DISCARDED
  rows      Json // [{ retailerId, ledger, beforePaise, afterPaise }]
  summary   Json // counts and the lines that did not match anything
  createdAt DateTime  @default(now())
  appliedAt DateTime?

  @@index([createdAt])
}

// Names the client sets up in Tally, kept in the database so the desk can fix them without a code change.
model TallySetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Server errors, grouped by what went wrong, so a problem is seen once with a count instead of a thousand times.
model ErrorLog {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  route       String?
  method      String?
  digest      String?
  detail      String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  alertedAt   DateTime?
  resolved    Boolean   @default(false)

  @@index([lastSeenAt])
}

// Generic sliding-window rate limiting (OTP requests, failed desk logins).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // e.g. "otp:+919000000001", "desk:ip:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// OTP codes are stored hashed, expire, are single-use and attempt-limited.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}
